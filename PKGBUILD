# Maintainer: Clove Twilight <clove@doughmination.gay>
#
# The MorvaneOS look for LXQt. Everything installed is generated by tools/build.py and
# committed, so building the package needs nothing but the repo.

pkgname=morvane-lxqt-theme
pkgver=1.0.0
pkgrel=1
pkgdesc='MorvaneOS look for LXQt: panel theme, Qt colours, window borders, icons, cursor and wallpaper'
arch=(any)
url='https://github.com/MorvaneOS/morvane-lxqt-theme'
# The LXQt theme and settings are LXQt's (LGPL) with MorvaneOS colours; the Openbox
# config is Openbox's own (GPL) with the MorvaneOS window theme
license=(LGPL-2.1-or-later GPL-2.0-or-later)
depends=(
  morvane-gtk-theme   # Openbox window borders, GTK apps, icons, cursor; XDG_CONFIG_DIRS
  morvane-wallpapers
)
backup=(
  etc/xdg/morvaneos/lxqt/lxqt.conf
  etc/xdg/morvaneos/lxqt/session.conf
  etc/xdg/morvaneos/pcmanfm-qt/lxqt/settings.conf
  etc/xdg/morvaneos/openbox/rc.xml
  etc/xdg/morvaneos/openbox/lxqt-rc.xml
)

package() {
  install -d "$pkgdir/usr/share/lxqt/themes"
  cp -a "$startdir"/theme/morvane-dark "$pkgdir/usr/share/lxqt/themes/"
  # Links to LXQt's shared artwork, listed rather than kept in the repo (see build.py)
  local path target
  while read -r path target; do
    ln -s "$target" "$pkgdir/usr/share/lxqt/themes/$path"
  done < "$startdir"/theme/symlinks
  # Found before LXQt's, pcmanfm-qt's and Openbox's own (see README)
  cp -r "$startdir"/config/* "$pkgdir/"
  find "$pkgdir" -type d -exec chmod 755 {} + -o -type f -exec chmod 644 {} +
}
